<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
   name="CertificadoUNS"
    pageWidth="842" pageHeight="595"
     orientation="Landscape"
      leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
    
        <!-- PARÁMETROS -->
            <parameter name="P_CODIGO" class="java.lang.String"/>
                <parameter name="P_NOMBRE_COMPLETO" class="java.lang.String"/>
                    <parameter name="P_CURSO" class="java.lang.String"/>
                        <parameter name="P_HORAS" class="java.lang.String"/>
                            <parameter name="P_FECHA_INICIO" class="java.lang.String"/>
                                <parameter name="P_FECHA_FIN" class="java.lang.String"/>
                                    <parameter name="P_LUGAR_FECHA" class="java.lang.String"/>
                                        <parameter name="P_QR_TEXTO" class="java.lang.String"/>
                                        
                                            <detail>
                                                        <band height="595">
                                                            
                                                                        <!-- FONDO BLANCO -->
                                                                                    <rectangle>
                                                                                                        <reportElement x="0" y="0" width="842" height="595"/>
                                                                                                                        <graphicElement>
                                                                                                                                                <pen lineWidth="0"/>
                                                                                                                        </graphicElement>
                                                                                    </rectangle>
                                                                                    
                                                                                                <!-- BORDE DECORATIVO EXTERIOR -->
                                                                                                            <rectangle>
                                                                                                                                <reportElement x="20" y="20" width="802" height="555"/>
                                                                                                                                                <graphicElement>
                                                                                                                                                                        <pen lineWidth="2" lineColor="#8B0000"/>
                                                                                                                                                </graphicElement>
                                                                                                            </rectangle>
                                                                                                            
                                                                                                                        <!-- BORDE DECORATIVO INTERIOR -->
                                                                                                                                    <rectangle>
                                                                                                                                                        <reportElement x="25" y="25" width="792" height="545"/>
                                                                                                                                                                        <graphicElement>
                                                                                                                                                                                                <pen lineWidth="1" lineColor="#D4AF37"/>
                                                                                                                                                                        </graphicElement>
                                                                                                                                    </rectangle>
                                                                                                                                    
                                                                                                                                                <!-- Logo UNS (esquina superior izquierda) -->
                                                                                                                                                            <image>
                                                                                                                                                                                <reportElement x="50" y="40" width="80" height="80"/>
                                                                                                                                                                                                <imageExpression><![CDATA[Thread.currentThread().getContextClassLoader().getResourceAsStream("images/logoUNS.png")]]></imageExpression>
                                                                                                                                                            </image>
                                                                                                                                                            
                                                                                                                                                                        <!-- Logo Cecomp (esquina superior derecha) -->
                                                                                                                                                                                    <image>
                                                                                                                                                                                                        <reportElement x="712" y="40" width="80" height="80"/>
                                                                                                                                                                                                                        <imageExpression><![CDATA[Thread.currentThread().getContextClassLoader().getResourceAsStream("images/logoCecomp.png")]]></imageExpression>
                                                                                                                                                                                    </image>
                                                                                                                                                                                    
                                                                                                                                                                                                <!-- Título de la Universidad -->
                                                                                                                                                                                                            <staticText>
                                                                                                                                                                                                                                <reportElement x="200" y="45" width="442" height="25"/>
                                                                                                                                                                                                                                                <textElement textAlignment="Center" fontName="Times New Roman" size="16" isBold="true"/>
                                                                                                                                                                                                                                                                <text><![CDATA[UNIVERSIDAD NACIONAL DEL SANTA]]></text>
                                                                                                                                                                                                            </staticText>
                                                                                                                                                                                                            
                                                                                                                                                                                                                        <!-- Subtítulo -->
                                                                                                                                                                                                                                    <staticText>
                                                                                                                                                                                                                                                        <reportElement x="200" y="68" width="442" height="20"/>
                                                                                                                                                                                                                                                                        <textElement textAlignment="Center" fontName="Times New Roman" size="11"/>
                                                                                                                                                                                                                                                                                        <text><![CDATA[Centro de Cómputo]]></text>
                                                                                                                                                                                                                                    </staticText>
                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                <!-- Código del certificado -->
                                                                                                                                                                                                                                                            <textField>
                                                                                                                                                                                                                                                                                <reportElement x="50" y="130" width="200" height="20"/>
                                                                                                                                                                                                                                                                                                <textElement textAlignment="Left" fontName="Arial" size="10"/>
                                                                                                                                                                                                                                                                                                                <textFieldExpression><![CDATA["Código: " + $P{P_CODIGO}]]></textFieldExpression>
                                                                                                                                                                                                                                                            </textField>
                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                        <!-- Título CERTIFICADO -->
                                                                                                                                                                                                                                                                                    <staticText>
                                                                                                                                                                                                                                                                                                        <reportElement x="300" y="160" width="242" height="45"/>
                                                                                                                                                                                                                                                                                                                        <textElement textAlignment="Center" fontName="Times New Roman" size="28" isBold="true"/>
                                                                                                                                                                                                                                                                                                                                        <text><![CDATA[CERTIFICADO]]></text>
                                                                                                                                                                                                                                                                                    </staticText>
                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                <!-- Línea decorativa bajo el título -->
                                                                                                                                                                                                                                                                                                            <rectangle>
                                                                                                                                                                                                                                                                                                                                <reportElement x="320" y="205" width="202" height="2"/>
                                                                                                                                                                                                                                                                                                                                                <graphicElement>
                                                                                                                                                                                                                                                                                                                                                                        <pen lineWidth="1" lineColor="#8B0000"/>
                                                                                                                                                                                                                                                                                                                                                </graphicElement>
                                                                                                                                                                                                                                                                                                            </rectangle>
                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                        <!-- Texto introductorio -->
                                                                                                                                                                                                                                                                                                                                    <staticText>
                                                                                                                                                                                                                                                                                                                                                        <reportElement x="120" y="230" width="602" height="30"/>
                                                                                                                                                                                                                                                                                                                                                                        <textElement textAlignment="Center" fontName="Arial" size="12"/>
                                                                                                                                                                                                                                                                                                                                                                                        <text><![CDATA[El Centro de Cómputo de la Universidad Nacional del Santa otorga el presente reconocimiento a:]]></text>
                                                                                                                                                                                                                                                                                                                                    </staticText>
                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                <!-- Nombre del estudiante -->
                                                                                                                                                                                                                                                                                                                                                            <textField isStretchWithOverflow="true">
                                                                                                                                                                                                                                                                                                                                                                                <reportElement x="120" y="275" width="602" height="35"/>
                                                                                                                                                                                                                                                                                                                                                                                                <textElement textAlignment="Center" fontName="Times New Roman" size="18" isBold="true"/>
                                                                                                                                                                                                                                                                                                                                                                                                                <textFieldExpression><![CDATA[$P{P_NOMBRE_COMPLETO}]]></textFieldExpression>
                                                                                                                                                                                                                                                                                                                                                                                                                            </text









































































































