<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:c="http://jasperreports.sourceforge.net/jasperreports/components"
 xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
 name="CertificadoUNS"
 pageWidth="842" pageHeight="595"
 orientation="Landscape"
 leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">

    <!-- PARÁMETROS -->
    <parameter name="P_FONDO" class="java.io.InputStream"/>
    <parameter name="P_CODIGO" class="java.lang.String"/>
    <parameter name="P_NOMBRE_COMPLETO" class="java.lang.String"/>
    <parameter name="P_CURSO" class="java.lang.String"/>
    <parameter name="P_HORAS" class="java.lang.String"/>
    <parameter name="P_FECHA_INICIO" class="java.lang.String"/>
    <parameter name="P_FECHA_FIN" class="java.lang.String"/>
    <parameter name="P_LUGAR_FECHA" class="java.lang.String"/>
    <parameter name="P_QR_TEXTO" class="java.lang.String"/>

    <detail>
        <band height="595">

            <!-- Fondo del certificado -->
            <tr>
                <reportElement x="0" y="0" width="842" height="595"/>
                <imageExpression><![CDATA[$P{P_FONDO}]]></imageExpression>
            </image>

            <!-- Logo UNS (esquina superior izquierda) -->
            <tr>
                <reportElement x="40" y="30" width="80" height="80"/>
                <imageExpression><![CDATA[Thread.currentThread().getContextClassLoader().getResourceAsStream("images/logoUNS.png")]]></imageExpression>
            </image>

            <!-- Código -->
            <textField>
                <reportElement x="160" y="65" width="200" height="20"/>
                <textElement textAlignment="Left" fontName="Arial" size="10"/>
                <textFieldExpression><![CDATA[$P{P_CODIGO}]]></textFieldExpression>
            </textField>

            <!-- Título CERTIFICADO -->
            <staticText>
                <reportElement x="300" y="120" width="242" height="40"/>
                <textElement textAlignment="Center" fontName="Arial" size="26" isBold="true"/>
                <text><![CDATA[CERTIFICADO]]></text>
            </staticText>

            <!-- Texto introductorio -->
            <staticText>
                <reportElement x="120" y="180" width="602" height="40"/>
                <textElement textAlignment="Center" fontName="Arial" size="12"/>
                <text><![CDATA[El Centro de Cómputo de la Universidad Nacional del Santa otorga el presente reconocimiento a:]]></text>
            </staticText>

            <!-- Nombre del estudiante -->
            <textField>
                <reportElement x="120" y="230" width="602" height="35"/>
                <textElement textAlignment="Center" fontName="Arial" size="16" isBold="true"/>
                <textFieldExpression><![CDATA[$P{P_NOMBRE_COMPLETO}]]></textFieldExpression>
            </textField>

            <!-- Descripción del curso -->
            <textField isStretchWithOverflow="true">
                <reportElement x="120" y="280" width="602" height="60"/>
                <textElement textAlignment="Center" fontName="Arial" size="12"/>
                <textFieldExpression><![CDATA[
"Por haber aprobado el curso de \"" + $P{P_CURSO} + "\" con una duración de " + $P{P_HORAS} + 
" horas teórico-prácticas, desarrollado del " + $P{P_FECHA_INICIO} + " al " + $P{P_FECHA_FIN} + "."
                ]]></textFieldExpression>
            </textField>

            <!-- Lugar y fecha -->
            <textField>
                <reportElement x="450" y="370" width="272" height="20"/>
                <textElement textAlignment="Right" fontName="Arial" size="11"/>
                <textFieldExpression><![CDATA[$P{P_LUGAR_FECHA}]]></textFieldExpression>
            </textField>

            <!-- Firma 1 - Decano -->
            <staticText>
                <reportElement x="150" y="430" width="250" height="40"/>
                <textElement textAlignment="Center" fontName="Arial" size="10"/>
                <text><![CDATA[___________________________________]]></text>
            </staticText>
            <staticText>
                <reportElement x="150" y="445" width="250" height="20"/>
                <textElement textAlignment="Center" fontName="Arial" size="10" isBold="true"/>
                <text><![CDATA[Dr. Hugo Esteban Caselli Gismondi]]></text>
            </staticText>
            <staticText>
                <reportElement x="150" y="460" width="250" height="15"/>
                <textElement textAlignment="Center" fontName="Arial" size="9"/>
                <text><![CDATA[Decano de la Facultad de Ingeniería]]></text>
            </staticText>

            <!-- Firma 2 - Director del Cecomp -->
            <staticText>
                <reportElement x="442" y="430" width="250" height="40"/>
                <textElement textAlignment="Center" fontName="Arial" size="10"/>
                <text><![CDATA[___________________________________]]></text>
            </staticText>
            <staticText>
                <reportElement x="442" y="445" width="250" height="20"/>
                <textElement textAlignment="Center" fontName="Arial" size="10" isBold="true"/>
                <text><![CDATA[Ms. Carlos Alfredo Mendoza Corpus]]></text>
            </staticText>
            <staticText>
                <reportElement x="442" y="460" width="250" height="15"/>
                <textElement textAlignment="Center" fontName="Arial" size="9"/>
                <text><![CDATA[Director del Cecomp]]></text>
            </staticText>

            <!-- QR Code -->
            <componentElement>
                <reportElement x="680" y="20" width="100" height="100"/>
                <c:qrCode>
                    <c:codeExpression><![CDATA[$P{P_QR_TEXTO}]]></c:codeExpression>
                    <c:errorCorrectionLevel>M</c:errorCorrectionLevel>
                </c:qrCode>
            </componentElement>

        </band>
    </detail>

</jasperReport>