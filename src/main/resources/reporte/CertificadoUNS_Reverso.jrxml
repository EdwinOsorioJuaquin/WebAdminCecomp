                          pdfFontName="Times-Bold" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[REGISTRO DE EVALUACIÓN]]></text>
            </staticText>

            <!-- Cabecera de la tabla -->
            <rectangle>
                <reportElement x="408" y="94" width="374" height="14" backcolor="#F5EAEA" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="414" y="94" width="200" height="14" forecolor="#5F5E5A"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Arial" size="7" isBold="true"
                          pdfFontName="Helvetica-Bold" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[COMPONENTE DE EVALUACIÓN]]></text>
            </staticText>
            <staticText>
                <reportElement x="620" y="94" width="50" height="14" forecolor="#5F5E5A"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="7" isBold="true"
                          pdfFontName="Helvetica-Bold" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[NOTA]]></text>
            </staticText>
            <staticText>
                <reportElement x="672" y="94" width="106" height="14" forecolor="#5F5E5A"/>
