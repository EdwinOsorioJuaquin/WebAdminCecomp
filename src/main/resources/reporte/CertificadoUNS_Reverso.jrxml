                    <font fontName="Arial" size="7" isBold="true"
                          pdfFontName="Helvetica-Bold" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[ESTADO]]></text>
            </staticText>
            <line>
                <reportElement x="408" y="108" width="374" height="1" forecolor="#D4AF37"/>
                <graphicElement><pen lineWidth="0.7" lineStyle="Solid"/></graphicElement>
            </line>

            <!-- FILA: Módulo 1 -->
            <staticText>
                <reportElement x="414" y="111" width="200" height="14"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Arial" size="8"
                          pdfFontName="Helvetica" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Módulo I — Herramientas de Productividad]]></text>
