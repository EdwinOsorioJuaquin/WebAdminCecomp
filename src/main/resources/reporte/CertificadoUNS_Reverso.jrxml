                        ? "\u25b8  " + $P{P_MOD3_TEMAS}.split("\\|")[2] : ""]]>
                </textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="26" y="291" width="358" height="12" forecolor="#888780"/>
                <textElement>
                    <font fontName="Arial" size="7" isItalic="true"
                          pdfFontName="Helvetica-Oblique" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[10 horas lectivas]]></text>
            </staticText>

            <!-- MÓDULO 4 -->
            <rectangle>
                <reportElement x="22" y="308" width="366" height="16" backcolor="#8B0000" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement x="26" y="308" width="358" height="16" forecolor="#FFFDF7"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="9" isBold="true"
                          pdfFontName="Times-Bold" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression class="java.lang.String">
                    <![CDATA[$P{P_MOD4_TITULO}]]>
                </textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="26" y="327" width="358" height="14"/>
                <textElement>
                    <font fontName="Arial" size="8"
                          pdfFontName="Helvetica" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression class="java.lang.String">
                    <![CDATA[($P{P_MOD4_TEMAS} != null && $P{P_MOD4_TEMAS}.split("\\|").length > 0)
                        ? "\u25b8  " + $P{P_MOD4_TEMAS}.split("\\|")[0] : ""]]>
                </textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="26" y="341" width="358" height="14"/>
                <textElement>
                    <font fontName="Arial" size="8"
                          pdfFontName="Helvetica" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression class="java.lang.String">
                    <![CDATA[($P{P_MOD4_TEMAS} != null && $P{P_MOD4_TEMAS}.split("\\|").length > 1)
                        ? "\u25b8  " + $P{P_MOD4_TEMAS}.split("\\|")[1] : ""]]>
                </textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="26" y="355" width="358" height="14"/>
                <textElement>
                    <font fontName="Arial" size="8"
                          pdfFontName="Helvetica" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression class="java.lang.String">
                    <![CDATA[($P{P_MOD4_TEMAS} != null && $P{P_MOD4_TEMAS}.split("\\|").length > 2)
                        ? "\u25b8  " + $P{P_MOD4_TEMAS}.split("\\|")[2] : ""]]>
                </textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="26" y="369" width="358" height="12" forecolor="#888780"/>
                <textElement>
                    <font fontName="Arial" size="7" isItalic="true"
