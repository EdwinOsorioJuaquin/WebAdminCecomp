                <text><![CDATA[10 horas lectivas]]></text>
            </staticText>

            <!-- Línea vertical central separadora -->
            <line>
                <reportElement x="401" y="72" width="1" height="390" forecolor="#D4AF37"/>
                <graphicElement>
                    <pen lineWidth="0.6" lineStyle="Dashed"/>
                </graphicElement>
            </line>

            <!-- ==================================================
                 COLUMNA DERECHA — CALIFICACIONES (x: 408 a 788)
            ================================================== -->

            <!-- Título sección -->
            <rectangle>
                <reportElement x="408" y="74" width="374" height="16" backcolor="#D4AF37" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="408" y="74" width="374" height="16" forecolor="#2C2C2A"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
