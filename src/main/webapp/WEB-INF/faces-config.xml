<?xml version='1.0' encoding='UTF-8'?>
<faces-config version="4.0"
              xmlns="https://jakarta.ee/xml/ns/jakartaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-facesconfig_4_0.xsd">

    <navigation-rule>

        <lifecycle>
            <phase-listener>libreriaUdemsi.session.LastAccessListener</phase-listener>
        </lifecycle>
        <factory>
            <exception-handler-factory>libreriaUdemsi.session.CustomExceptionHandlerFactory</exception-handler-factory>
        </factory>
        <from-view-id>*</from-view-id>

        <!-- =====================================
             ACCESO
        ====================================== -->
        <navigation-case>
            <from-outcome>acceso.ok</from-outcome>
            <to-view-id>/bienvenido.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

        <navigation-case>
            <from-outcome>acceso.error</from-outcome>
            <to-view-id>/login.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

        <navigation-case>
            <from-outcome>certificado.validar</from-outcome>
            <to-view-id>/validarCertificado.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

        <!-- =====================================
             ALUMNOS
        ====================================== -->
        <navigation-case>
            <from-outcome>alumnos.registro</from-outcome>
            <to-view-id>/pages/alumnos/registrarAlumnos.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

        <navigation-case>
            <from-outcome>alumnos.lista</from-outcome>
            <to-view-id>/pages/alumnos/listaAlumnos.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

        <!-- =====================================
             CURSOS
        ====================================== -->
        <navigation-case>
            <from-outcome>cursos.lista</from-outcome>
            <to-view-id>/pages/cursos/Cursos.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

        <navigation-case>
            <from-outcome>cursos.precios</from-outcome>
            <to-view-id>/pages/cursos/Precios.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

        <navigation-case>
            <from-outcome>cursos.plan</from-outcome>
            <to-view-id>/pages/cursos/PlanCurricular.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

        <!-- =====================================
             GRUPOS
        ====================================== -->
        <navigation-case>
            <from-outcome>grupos.gestionarGrupos</from-outcome>
            <to-view-id>/pages/grupos/gestionarGrupos.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

        <navigation-case>
            <from-outcome>grupos.docentes</from-outcome>
            <to-view-id>/pages/grupos/listarDocentes.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

        <!-- =====================================
             CERTIFICADOS
        ====================================== -->
        <navigation-case>
            <from-outcome>certificados.gestionar</from-outcome>
            <to-view-id>/pages/certificados/gestionarCertificados.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

        <navigation-case>
            <from-outcome>certificados.pendientes</from-outcome>
            <to-view-id>/pages/certificadosPendientes.xhtml</to-view-id>
            <redirect/>
        </navigation-case>
        
        <navigation-case>
            <from-outcome>certificados.registros</from-outcome>
            <to-view-id>/pages/certificadosRegistroDecanatura.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

        <!-- =====================================
             FICHAS
        ====================================== -->
        <navigation-case>
            <from-outcome>fichas.gestionarFichas</from-outcome>
            <to-view-id>/pages/fichas/gestionarFichas.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

        <!-- =====================================
             PAGOS
        ====================================== -->
        <navigation-case>
            <from-outcome>pagos.lista</from-outcome>
            <to-view-id>/pages/pagos/listaPagosCecomp.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

        <!-- =====================================
             CONFIGURACIONES EXTRA
        ====================================== -->
        <navigation-case>
            <from-outcome>gestionar.tiposdepago</from-outcome>
            <to-view-id>/pages/gestionarTipoPago.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

        <navigation-case>
            <from-outcome>gestionar.notas</from-outcome>
            <to-view-id>/pages/gestionarNotas.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

        <!-- =====================================
             REPORTES
        ====================================== -->
        <navigation-case>
            <from-outcome>reportes.certificados</from-outcome>
            <to-view-id>/pages/reportesCertificados.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

        <navigation-case>
            <from-outcome>reportes.tokens</from-outcome>
            <to-view-id>/pages/reportesTokens.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

    </navigation-rule>

</faces-config>